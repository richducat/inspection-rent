diff --git a/test/property-versioning.test.mjs b/test/property-versioning.test.mjs
new file mode 100644
index 0000000..211bae6
--- /dev/null
+++ b/test/property-versioning.test.mjs
@@ -0,0 +1,131 @@
+// Cross-device saves are versioned: PUT /properties/:id honours If-Match /
+// baseVersion and refuses a stale base with 409 version_conflict, so a device
+// that loaded an inspection earlier can never silently overwrite the photos
+// another device saved since. GET and PUT return the version (and an ETag).
+// The property-count 409 carries its own code so it is never read as a conflict.
+import test, { after } from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+process.env.DB_PATH = path.join(fs.mkdtempSync(path.join(os.tmpdir(), "hip-versioning-")), "accounts.db");
+process.env.ADMIN_PASSWORD = "test-admin-password-1";
+process.env.JWT_SECRET = "test-secret-test-secret-test-secret";
+process.env.PORT = "0";
+process.env.MAX_PROPERTIES_PER_ACCOUNT = "2";
+
+const { server } = await import("../src/server.mjs");
+const { db, insertAccount, accountById, setPlan } = await import("../src/db.mjs");
+const { signToken } = await import("../src/auth.mjs");
+const { propertyVersion } = await import("../src/properties.mjs");
+
+await new Promise((resolve) => (server.listening ? resolve() : server.once("listening", resolve)));
+const base = `http://127.0.0.1:${server.address().port}`;
+
+after(() => {
+  server.close();
+  db.close();
+});
+
+insertAccount({
+  id: "ver",
+  username: "u-ver",
+  email: "ver@t.local",
+  display_name: "ver",
+  role: "inspector",
+  pass_hash: "x",
+  plan: "annual",
+  subscription_status: "active",
+  created_at: new Date().toISOString(),
+});
+setPlan("ver", "annual", "annual");
+const token = signToken(accountById("ver"));
+
+const photos = (n) => Array.from({ length: n }, (_, i) => ({ id: `p${i}` }));
+async function put(id, body, headers = {}) {
+  const res = await fetch(`${base}/properties/${id}`, {
+    method: "PUT",
+    headers: { "content-type": "application/json", authorization: `Bearer ${token}`, ...headers },
+    body: JSON.stringify(body),
+  });
+  return { status: res.status, etag: res.headers.get("etag"), body: await res.json() };
+}
+async function get(id) {
+  const res = await fetch(`${base}/properties/${id}`, { headers: { authorization: `Bearer ${token}` } });
+  return { status: res.status, etag: res.headers.get("etag"), body: await res.json() };
+}
+const job = (n) => ({ id: "job-1", property: { address: "1 Sync St" }, photos: photos(n) });
+
+test("a new property is version 1; GET and PUT return it with an ETag", async () => {
+  const created = await put("job-1", { inspection: job(15) });
+  assert.equal(created.status, 200);
+  assert.equal(created.body.version, 1);
+  assert.equal(created.etag, '"1"');
+  const loaded = await get("job-1");
+  assert.equal(loaded.body.version, 1);
+  assert.equal(loaded.etag, '"1"');
+  assert.equal(loaded.body.inspection.photos.length, 15);
+});
+
+test("a save with the current base is accepted and bumps the version; a STALE base is refused and nothing is lost", async () => {
+  // Device A saves on top of version 1.
+  const a = await put("job-1", { inspection: job(20) }, { "If-Match": "1" });
+  assert.equal(a.status, 200);
+  assert.equal(a.body.version, 2);
+  // Device B still holds version 1 with only 10 photos.
+  const b = await put("job-1", { inspection: job(10) }, { "If-Match": "1" });
+  assert.equal(b.status, 409);
+  assert.equal(b.body.code, "version_conflict");
+  assert.equal(b.body.version, 2, "tells the stale device the current version");
+  assert.equal((await get("job-1")).body.inspection.photos.length, 20, "device A's photos survive");
+  assert.equal(propertyVersion("ver", "job-1"), 2);
+  // baseVersion in the body is the fallback channel; a quoted / weak ETag is accepted.
+  const c = await put("job-1", { inspection: job(21), baseVersion: 2 });
+  assert.equal(c.status, 200);
+  assert.equal(c.body.version, 3);
+  const d = await put("job-1", { inspection: job(22) }, { "If-Match": 'W/"3"' });
+  assert.equal(d.status, 200);
+  assert.equal(d.body.version, 4);
+  // The header wins over the body when both are sent.
+  const e = await put("job-1", { inspection: job(23), baseVersion: 1 }, { "If-Match": "4" });
+  assert.equal(e.status, 200);
+  assert.equal(e.body.version, 5);
+});
+
+test("no base at all is unconditional (old clients, offline replay) — exactly the old behaviour", async () => {
+  const res = await put("job-1", { inspection: job(11) });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.version, 6);
+  assert.equal((await get("job-1")).body.inspection.photos.length, 11);
+});
+
+test("a malformed base is a 400, not a silent overwrite", async () => {
+  for (const headers of [{ "If-Match": "abc" }, { "If-Match": "0" }]) {
+    const res = await put("job-1", { inspection: job(1) }, headers);
+    assert.equal(res.status, 400);
+    assert.equal(res.body.code, "bad_version");
+  }
+  const body = await put("job-1", { inspection: job(1), baseVersion: -3 });
+  assert.equal(body.status, 400);
+  assert.equal((await get("job-1")).body.inspection.photos.length, 11, "unchanged");
+});
+
+test("the property-count 409 carries its own code, distinct from a version conflict", async () => {
+  assert.equal((await put("job-2", { inspection: { id: "job-2", property: { address: "2 Cap St" } } })).status, 200);
+  const third = await put("job-3", { inspection: { id: "job-3", property: { address: "3 Cap St" } } });
+  assert.equal(third.status, 409);
+  assert.equal(third.body.code, "property_limit");
+  assert.equal(third.body.limit, 2);
+  // Updating an existing one at the cap is fine, and still versioned.
+  const upd = await put("job-2", { inspection: { id: "job-2", property: { address: "2 Cap St" }, note: "x" } }, { "If-Match": "1" });
+  assert.equal(upd.status, 200);
+  assert.equal(upd.body.version, 2);
+});
+
+test("list summaries carry the version", async () => {
+  const res = await fetch(`${base}/properties`, { headers: { authorization: `Bearer ${token}` } });
+  const { properties } = await res.json();
+  const one = properties.find((p) => p.id === "job-1");
+  assert.equal(one.version, 6);
+});
